# ==============================================================================
# Ghostty Terminal Configuration - macOS
# ==============================================================================
# Comprehensive configuration for optimal macOS integration with zsh shell
# Includes Gruvbox theme, performance optimizations, and proper keybindings
# ==============================================================================

# ============================================
# Shell Integration
# ============================================

# Shell integration (CRITICAL: Must be zsh, not fish)
shell-integration = zsh

# ============================================
# Theme Configuration
# ============================================

# Auto dark/light: follows macOS appearance
theme = light:gruvbox-light-custom,dark:gruvbox-dark-custom

# Optional local overrides (machine-specific settings)
config-file = ?config.local

# ============================================
# Font Configuration
# ============================================

# Primary font family (IosevkaTerm Nerd Font for CLI compatibility)
# Verify font name with: fc-list | grep -i iosevka
font-family = IosevkaTerm Nerd Font

# Font size optimized for Retina displays
font-size = 16

# Font rendering is handled automatically by Ghostty

# Bold and italic font variants
font-family-bold = IosevkaTerm Nerd Font
font-family-italic = IosevkaTerm Nerd Font

# ============================================
# macOS-Specific Settings
# ============================================

# Native macOS window controls with top bar information
macos-titlebar-style = native
macos-titlebar-proxy-icon = visible
macos-window-buttons = visible

# Window configuration for better title bar integration
window-decoration = true
window-theme = auto

# Option key behavior for terminal compatibility
macos-option-as-alt = true

# Validated macOS settings for Ghostty

# ============================================
# Window Configuration
# ============================================

# Window padding for better readability
window-padding-x = 8
window-padding-y = 8

# Tab bar configuration for status-like functionality
window-show-tab-bar = auto
window-new-tab-position = current

# Window styling - opacity and blur handled by themes
# background-opacity and background-blur are set in theme files

# Resize overlay configuration for visual feedback
resize-overlay = after-first
resize-overlay-position = center

# Window dimensions on startup
window-width = 120
window-height = 40

# Dim inactive splits (matches WezTerm inactive_pane_hsb brightness = 0.7)
unfocused-split-opacity = 0.7

# ============================================
# Keybinding Configuration
# ============================================
# Phase 2 port from WezTerm. Items marked (default) are Ghostty defaults
# and are omitted here (cmd+enter=fullscreen, ctrl+tab=next_tab, font size).

# Config reload
keybind = super+r=reload_config

# Shift+Enter sends LF (distinguishes shift+enter from plain enter in some apps)
keybind = shift+enter=text:\n

# Window / tab management
keybind = super+shift+w=close_window
keybind = super+one=goto_tab:1
keybind = super+two=goto_tab:2
keybind = super+three=goto_tab:3
keybind = super+four=goto_tab:4
keybind = super+five=goto_tab:5
keybind = super+six=goto_tab:6
keybind = super+seven=goto_tab:7
keybind = super+eight=goto_tab:8
keybind = super+nine=last_tab

# Splits
keybind = super+d=new_split:right
keybind = super+shift+d=new_split:down
keybind = super+shift+z=toggle_split_zoom
keybind = super+alt+left=goto_split:left
keybind = super+alt+right=goto_split:right
keybind = super+alt+up=goto_split:up
keybind = super+alt+down=goto_split:down
keybind = super+shift+up=resize_split:up,5
keybind = super+shift+down=resize_split:down,5
keybind = super+shift+left=resize_split:left,5
keybind = super+shift+right=resize_split:right,5

# Line navigation (Home/End escape sequences for readline / shell editors)
keybind = super+left=text:\x1bOH
keybind = super+right=text:\x1bOF

# Scroll
keybind = super+up=scroll_page_up
keybind = super+down=scroll_page_down

# Readline word navigation (option as alt is set globally; these ensure \x1bb/\x1bf)
keybind = alt+left=text:\x1bb
keybind = alt+right=text:\x1bf

# Kill line (ctrl+u / readline backward-kill-line)
keybind = super+backspace=text:\x15

# Clear scrollback
keybind = super+k=clear_screen

# Command palette
keybind = super+shift+p=toggle_command_palette

# Tab rename workaround (Phase 3): Ghostty has no built-in rename prompt.
# Use the shell function instead: tab-title my-task
# Bind cmd+shift+r to type the function name as a convenience starter.
keybind = super+shift+r=text:tab-title

# ============================================
# Clipboard Integration
# ============================================

# Allow reading from system clipboard
clipboard-read = allow

# Allow writing to system clipboard
clipboard-write = allow

# ============================================
# Tmux Integration
# ============================================

# Tmux integration (use tmux keybindings within tmux sessions)
# Keybindings for tmux are handled by tmux itself

# ============================================
# Mouse Configuration
# ============================================

# Mouse settings are handled automatically by Ghostty

# ============================================
# Bell and Notifications
# ============================================

audible-bell = false

# ============================================
# Cursor Configuration
# ============================================

# Cursor shape (block for better visibility)
cursor-style = block

# Cursor blinking for better tracking
cursor-style-blink = false

# Cursor colors handled by custom themes

# ============================================
# Selection Configuration
# ============================================

# Auto-copy selection to clipboard
copy-on-select = true

# ============================================
# Advanced Configuration
# ============================================

# Shell command for new terminals
command = /bin/zsh

# Working directory - start in home directory
# Defaults to $HOME if not specified
# working-directory = ~

# Scrollback buffer (~50k lines equivalent)
scrollback-limit = 10mb

# Terminal type
term = xterm-256color

# Confirm exit on active processes
confirm-close-surface = true

# Focus follows mouse
focus-follows-mouse = false

# ============================================
# Development Environment
# ============================================

# Environment variables for Ghostty sessions
env = TERM=xterm-256color
env = COLORTERM=truecolor

# ============================================
# Troubleshooting and Debugging
# ============================================

# Debug settings are handled automatically by Ghostty

# ==============================================================================
# End of Configuration
# ==============================================================================
#
# This configuration provides:
# - Optimal macOS integration with native features
# - Gruvbox dark theme with amber/green palette for comfortable coding
# - GPU-accelerated rendering for smooth performance
# - Proper zsh shell integration without conflicts
# - Comprehensive keybindings for productivity
# - IosevkaTerm Nerd Font rendering optimized for Retina displays and CLI compatibility
# - Tmux integration for terminal multiplexing
# - Clipboard integration for seamless workflow
# - Local config support for machine-specific settings
#
# Restart Ghostty after making changes to see effects.
# For machine-specific overrides, edit ~/.config/ghostty/config.local
# ==============================================================================