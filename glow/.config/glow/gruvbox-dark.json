{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "#ebdbb2",
    "background_color": "#1d2021",
    "margin": 2
  },
  "block_quote": {
    "indent": 1,
    "indent_token": "| ",
    "color": "#b8bb26",
    "italic": true
  },
  "paragraph": {},
  "list": { "level_indent": 2 },
  "heading": {
    "block_suffix": "\n",
    "color": "#fe8019",
    "bold": true
  },
  "h1": {
    "prefix": " ",
    "suffix": " ",
    "color": "#1d2021",
    "background_color": "#fe8019",
    "bold": true
  },
  "h2": { "prefix": "## ", "color": "#fabd2f", "bold": true },
  "h3": { "prefix": "### ", "color": "#83a598", "bold": true },
  "h4": { "prefix": "#### ", "color": "#8ec07c", "bold": true },
  "h5": { "prefix": "##### ", "color": "#d3869b", "bold": true },
  "h6": { "prefix": "###### ", "color": "#a89984", "bold": false },
  "text": { "color": "#ebdbb2" },
  "strikethrough": { "crossed_out": true },
  "emph": { "italic": true },
  "strong": { "bold": true, "color": "#ebdbb2" },
  "hr": { "color": "#504945", "format": "\n--------\n" },
  "item": { "block_prefix": "- ", "color": "#fe8019" },
  "enumeration": { "block_prefix": ". ", "color": "#fe8019" },
  "task": { "ticked": "[x] ", "unticked": "[ ] " },
  "link": { "color": "#83a598", "underline": true },
  "link_text": { "color": "#83a598", "bold": true },
  "image": { "color": "#d3869b", "underline": true },
  "image_text": { "color": "#a89984", "format": "Image: {{.text}} ->" },
  "code": {
    "prefix": " ",
    "suffix": " ",
    "color": "#fb4934",
    "background_color": "#3c3836"
  },
  "code_block": {
    "color": "#ebdbb2",
    "background_color": "#3c3836",
    "margin": 2,
    "chroma": {
      "text":                { "color": "#ebdbb2" },
      "comment":             { "color": "#a89984", "italic": true },
      "comment_preproc":     { "color": "#fabd2f" },
      "keyword":             { "color": "#fb4934", "bold": true },
      "keyword_reserved":    { "color": "#fb4934" },
      "keyword_type":        { "color": "#fabd2f" },
      "operator":            { "color": "#ebdbb2" },
      "punctuation":         { "color": "#ebdbb2" },
      "name":                { "color": "#ebdbb2" },
      "name_builtin":        { "color": "#83a598" },
      "name_class":          { "color": "#fabd2f", "bold": true },
      "name_constant":       { "color": "#d3869b" },
      "name_function":       { "color": "#8ec07c" },
      "literal_number":      { "color": "#d3869b" },
      "literal_string":      { "color": "#b8bb26" },
      "literal_string_escape": { "color": "#fe8019" },
      "generic_deleted":     { "color": "#fb4934" },
      "generic_inserted":    { "color": "#b8bb26" },
      "generic_subheading":  { "color": "#a89984" },
      "background":          { "background_color": "#3c3836" }
    }
  },
  "table": { "color": "#ebdbb2" },
  "definition_term": { "color": "#fe8019", "bold": true },
  "definition_description": { "block_prefix": "\n> ", "color": "#ebdbb2" }
}