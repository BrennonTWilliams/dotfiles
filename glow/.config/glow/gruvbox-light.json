{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "#3c3836",
    "background_color": "#f9f5d7",
    "margin": 2
  },
  "block_quote": {
    "indent": 1,
    "indent_token": "| ",
    "color": "#79740e",
    "italic": true
  },
  "paragraph": {},
  "list": { "level_indent": 2 },
  "heading": {
    "block_suffix": "\n",
    "color": "#af3a03",
    "bold": true
  },
  "h1": {
    "prefix": " ",
    "suffix": " ",
    "color": "#f9f5d7",
    "background_color": "#af3a03",
    "bold": true
  },
  "h2": { "prefix": "## ", "color": "#b57614", "bold": true },
  "h3": { "prefix": "### ", "color": "#076678", "bold": true },
  "h4": { "prefix": "#### ", "color": "#427b58", "bold": true },
  "h5": { "prefix": "##### ", "color": "#8f3f71", "bold": true },
  "h6": { "prefix": "###### ", "color": "#7c6f64", "bold": false },
  "text": { "color": "#3c3836" },
  "strikethrough": { "crossed_out": true },
  "emph": { "italic": true },
  "strong": { "bold": true, "color": "#3c3836" },
  "hr": { "color": "#d5c4a1", "format": "\n--------\n" },
  "item": { "block_prefix": "- ", "color": "#af3a03" },
  "enumeration": { "block_prefix": ". ", "color": "#af3a03" },
  "task": { "ticked": "[x] ", "unticked": "[ ] " },
  "link": { "color": "#076678", "underline": true },
  "link_text": { "color": "#076678", "bold": true },
  "image": { "color": "#8f3f71", "underline": true },
  "image_text": { "color": "#7c6f64", "format": "Image: {{.text}} ->" },
  "code": {
    "prefix": " ",
    "suffix": " ",
    "color": "#9d0006",
    "background_color": "#ebdbb2"
  },
  "code_block": {
    "color": "#3c3836",
    "background_color": "#ebdbb2",
    "margin": 2,
    "chroma": {
      "text":                { "color": "#3c3836" },
      "comment":             { "color": "#7c6f64", "italic": true },
      "comment_preproc":     { "color": "#b57614" },
      "keyword":             { "color": "#af3a03", "bold": true },
      "keyword_reserved":    { "color": "#af3a03" },
      "keyword_type":        { "color": "#b57614" },
      "operator":            { "color": "#3c3836" },
      "punctuation":         { "color": "#3c3836" },
      "name":                { "color": "#3c3836" },
      "name_builtin":        { "color": "#076678" },
      "name_class":          { "color": "#79740e", "bold": true },
      "name_constant":       { "color": "#8f3f71" },
      "name_function":       { "color": "#427b58" },
      "literal_number":      { "color": "#8f3f71" },
      "literal_string":      { "color": "#79740e" },
      "literal_string_escape": { "color": "#af3a03" },
      "generic_deleted":     { "color": "#9d0006" },
      "generic_inserted":    { "color": "#79740e" },
      "generic_subheading":  { "color": "#7c6f64" },
      "background":          { "background_color": "#ebdbb2" }
    }
  },
  "table": { "color": "#3c3836" },
  "definition_term": { "color": "#af3a03", "bold": true },
  "definition_description": { "block_prefix": "\n> ", "color": "#3c3836" }
}